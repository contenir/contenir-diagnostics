{
    "name": "contenir/diagnostics",
    "description": "Diagnostic tools for Contenir CMS - system health checks, cache management, and troubleshooting",
    "type": "library",
    "license": "MIT",
    "keywords": ["contenir", "mezzio", "diagnostics", "health-check", "debugging"],
    "authors": [
        {
            "name": "Contenir",
            "email": "hello@contenir.com"
        }
    ],
    "require": {
        "php": "^8.2 || ^8.3",
        "psr/container": "^1.0 || ^2.0",
        "symfony/console": "^6.0 || ^7.0",
        "laminas/laminas-servicemanager": "^3.0",
        "laminas/laminas-cache": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.7",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Contenir\\Diagnostics\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Contenir\\Diagnostics\\Test\\": "test/"
        }
    },
    "extra": {
        "laminas": {
            "config-provider": "Contenir\\Diagnostics\\ConfigProvider"
        }
    },
    "bin": [
        "bin/diagnostics"
    ]
}