#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Runs the diagnostics command without laminas-cli. Run it from the
 * application root, which must have config/container.php:
 *
 *   vendor/bin/diagnostics [--fix]
 */

use Contenir\Diagnostics\Command\DiagnosticsCommand;
use Psr\Container\ContainerInterface;
use Symfony\Component\Console\Input\ArgvInput;
use Symfony\Component\Console\Output\ConsoleOutput;

$projectRoot   = (string) getcwd();
$containerFile = $projectRoot . '/config/container.php';

if (! file_exists($containerFile)) {
    fwrite(STDERR, "Error: Could not find container.php in {$projectRoot}/config/\n");
    fwrite(STDERR, "Please run this command from your application root directory.\n");
    exit(1);
}

require_once $_composer_autoload_path ?? $projectRoot . '/vendor/autoload.php';

/** @var ContainerInterface $container */
$container = require $containerFile;

try {
    $command = $container->get(DiagnosticsCommand::class);
} catch (Throwable $e) {
    fwrite(STDERR, 'Error: Could not load DiagnosticsCommand: ' . $e->getMessage() . "\n");
    exit(1);
}

exit($command->run(new ArgvInput(), new ConsoleOutput()));
